import { useState } from "react";
import { Plus, Minus, X } from "lucide-react";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Burger, Extra } from "../types";

const EXTRAS: Extra[] = [
  { id: 'e1', name: 'Extra Synthetic Beef', price: 5.00 },
  { id: 'e2', name: 'Digital Cheddar Overload', price: 2.50 },
  { id: 'e3', name: 'Bio-Bacon Slices', price: 3.50 },
  { id: 'e4', name: 'Spicy Kernel Sauce', price: 1.00 },
];

interface ExtrasModalProps {
  burger: Burger | null;
  isOpen: boolean;
  onClose: () => void;
  onConfirm: (burger: Burger, selectedExtras: Extra[]) => void;
}

export default function ExtrasModal({ burger, isOpen, onClose, onConfirm }: ExtrasModalProps) {
  const [selected, setSelected] = useState<Extra[]>([]);

  if (!burger) return null;

  const toggleExtra = (extra: Extra) => {
    setSelected(prev => 
      prev.find(e => e.id === extra.id) 
        ? prev.filter(e => e.id !== extra.id) 
        : [...prev, extra]
    );
  };

  const totalPrice = burger.price + selected.reduce((sum, e) => sum + e.price, 0);

  return (
    <Dialog open={isOpen} onOpenChange={(open) => !open && onClose()}>
      <DialogContent className="bg-[#050505] border-2 border-neon-cyan text-white sm:max-w-[425px] rounded-[15px] shadow-[0_0_50px_rgba(0,243,255,0.3)]">
        <DialogHeader>
          <div className="tech-label mb-2 text-neon-cyan">MOD_UPGRADE.OS</div>
          <DialogTitle className="text-2xl font-black italic tracking-tighter font-display text-neon-cyan neon-text-cyan flex items-center justify-between">
            {burger.name}
            <span className="text-neon-pink neon-text-pink text-sm ml-4 italic underline underline-offset-4 decoration-2 decoration-neon-pink">MODULES_REQUIRED</span>
          </DialogTitle>
        </DialogHeader>
        
        <div className="py-2 space-y-4 relative z-10">
          <p className="text-white/30 text-[10px] font-mono uppercase tracking-[0.3em] italic bg-neon-cyan/5 border-l-2 border-neon-cyan pl-2 py-1">Hardware Configuration:</p>
          <div className="space-y-2">
            {EXTRAS.map((extra) => {
              const isSelected = !!selected.find(e => e.id === extra.id);
              return (
                <div 
                  key={extra.id} 
                  onClick={() => toggleExtra(extra)}
                  className={`flex items-center justify-between p-4 border-2 transition-all ${isSelected ? 'border-neon-cyan bg-neon-cyan/10 shadow-[0_0_15px_rgba(0,243,255,0.2)]' : 'border-white/5 bg-white/5 hover:border-white/20'}`}
                >
                  <div className="flex items-center gap-4">
                    <div className={`w-5 h-5 border-2 flex items-center justify-center transition-all ${isSelected ? 'border-neon-cyan bg-neon-cyan shadow-[0_0_10px_#00f3ff]' : 'border-white/20'}`}>
                      {isSelected && <Plus size={14} className="text-black font-black" />}
                    </div>
                    <span className="text-xs font-mono font-bold tracking-widest uppercase">{extra.name}</span>
                  </div>
                  <span className="text-neon-pink font-mono text-xs font-black neon-text-pink">+R${extra.price.toFixed(2)}</span>
                </div>
              );
            })}
          </div>
        </div>

        <DialogFooter className="flex-col sm:flex-col gap-4 mt-6">
          <div className="flex justify-between items-center w-full pt-4 border-t-2 border-white/5">
            <span className="tech-label text-neon-cyan/40">COMPUTED_COST</span>
            <span className="text-3xl font-black font-display text-neon-cyan neon-text-cyan italic">R${totalPrice.toFixed(2)}</span>
          </div>
          <button 
            onClick={() => {
              onConfirm(burger, selected);
              setSelected([]);
            }}
            className="w-full btn-neon-cyan h-14 rounded-none !text-sm border-2 border-white hover:bg-white"
          >
            <span>CONFIRM_INSTALLATION</span>
          </button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
